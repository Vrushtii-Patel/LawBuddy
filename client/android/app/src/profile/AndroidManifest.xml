<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Local development only: lets the app talk to a plain-HTTP server on your computer
         (for example http://10.0.2.2:3000 from the Android emulator).
         The release manifest does not set this, so release builds only allow HTTPS. -->
    <application android:usesCleartextTraffic="true" />
</manifest>