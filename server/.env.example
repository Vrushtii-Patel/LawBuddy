# =============================================================================
# LawBuddy Server Environment Configuration Template
# Copy this file to .env and configure the values for your environment.
# NEVER commit .env to version control or share secrets publicly.
# =============================================================================

# HTTP Port (default: 3000)
PORT=3000

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String
# For local development: mongodb://127.0.0.1:27017/legal_scanner
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/legal_scanner?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/legal_scanner

# Primary LLM API Key (Google Gemini AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Fallback LLM Provider (OpenRouter: https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# JSON Web Token Secret for signing user authentication tokens
# Must be at least 32 characters long in production
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_here

# SMTP / Email Configuration (Used for password resets and OTP verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="LawBuddy <noreply@lawbuddy.in>"

# Optional Development Overrides
# Set to 'true' to log OTP to console in development when SMTP is not configured
# ALLOW_DEV_EMAIL_FALLBACK=true
